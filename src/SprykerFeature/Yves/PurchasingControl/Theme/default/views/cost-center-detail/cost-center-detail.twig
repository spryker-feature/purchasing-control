{% extends template('widget') %}

{% define data = {
    costCenterName: _widget.costCenterName,
    budgetName: _widget.budgetName,
    budgetSummary: _widget.budgetSummary,
} %}

{% block body %}
    {% include  molecule('cost-center-detail', 'PurchasingControl') with {
        data: {
            costCenterName: data.costCenterName,
            budgetName: data.budgetName,
            budgetSummary: data.budgetSummary,
        }
    } only %}
{% endblock %}
